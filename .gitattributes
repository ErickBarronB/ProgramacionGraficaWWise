# ---------------------------------------------------
# Unreal Engine 5.8 + Wwise .gitattributes
# Requires Git LFS: git lfs install
# ---------------------------------------------------

* text=auto eol=lf

# ---- Unreal binary asset types ----
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.upk    filter=lfs diff=lfs merge=lfs -text
*.udk    filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uptnl  filter=lfs diff=lfs merge=lfs -text

# ---- Wwise: banks and media imported into UE (Content/WwiseAudio) ----
# These ARE committed (UE needs them at runtime) — treat as binary/LFS
*.bnk filter=lfs diff=lfs merge=lfs -text
*.wem filter=lfs diff=lfs merge=lfs -text

# ---- Wwise: source authoring assets (WwiseProject/) ----
# Originals before conversion — also binary, also LFS
*.wav  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text

# ---- Wwise: authoring project definition files — KEEP AS TEXT ----
# .wproj, .wwu (work units), .wsou etc are XML — you WANT these
# diffable in Git, not LFS-blobbed, since that's how you track
# actual sound design changes (new events, RTPC curves, etc.)
*.wproj text eol=lf
*.wwu   text eol=lf
*.wfol  text eol=lf
*.wsou  text eol=lf
*.wctr  text eol=lf
*.wgrp  text eol=lf

# ---- Images / Textures ----
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# ---- 3D Models ----
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text

# ---- Video ----
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# ---- Fonts ----
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# ---- Archives / binaries ----
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z  filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# ---- Keep source/config diffable, NOT LFS ----
*.ini      text
*.cpp      text
*.h        text
*.cs       text
*.uproject text
*.uplugin  text
*.json     text
*.xml      text
*.md       text

# ---- Merge behavior ----
*.uproject merge=union